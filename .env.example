# =============================================================================
# LUMA API - Event data source
# =============================================================================
# Calendar ID from your Luma calendar. Get it by inspecting requests to api2.luma.com when you view your calendar on the web
LUMA_CALENDAR_ID=

# Secret for validating incoming Luma webhook requests
# Set this to a random secure string, then configure it in Luma's webhook settings
LUMA_WEBHOOK_SECRET=

# =============================================================================
# AWS SES - Email service
# =============================================================================
# AWS credentials for SES email service
# Get from: AWS Console → IAM → Users → Your User → Security Credentials
# Create access keys with SES sending permissions
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS region where SES is configured (defaults to us-east-1 if not set)
AWS_REGION=us-east-1

# =============================================================================
# DISCORD - Notifications and logging
# =============================================================================
# Webhook URL for posting event updates (weekly summaries, new event alerts)
# Create in: Discord channel → Settings → Integrations → Webhooks
DISCORD_EVENTS_WEBHOOK_URL=

# Webhook URL for error logging and system metrics (email job stats, errors)
# Create in: Discord channel → Settings → Integrations → Webhooks
# Can be the same as DISCORD_EVENTS_WEBHOOK_URL or a separate channel
DISCORD_LOGGING_WEBHOOK_URL=

# Discord role ID to ping when no events are scheduled
# Get by: Enable Developer Mode → Right-click role → Copy ID
DISCORD_MOD_ROLE_ID=

# =============================================================================
# DATABASE - Supabase Postgres
# =============================================================================
# PostgreSQL connection strings from Supabase
# Get from: Supabase Dashboard → Your Project → Settings → Database → Connect
#
# IMPORTANT: You need TWO different connection strings for different purposes:
#
# POSTGRES_URL: Transaction Mode Pooler (port 6543) - REQUIRED for serverless/Vercel
#   - Used by: Application runtime queries (all API routes, webhooks, cron jobs)
#   - Why: Transaction mode is optimized for serverless functions with many transient connections
#   - Does NOT support prepared statements (Kysely handles this automatically)
#   - Format options:
#     * Direct hostname: postgresql://postgres:[PASSWORD]@db.xxx.supabase.co:6543/postgres
#     * Pooler hostname: postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
#   - To get: Supabase Dashboard → Settings → Database → Connect → Transaction mode
#
# POSTGRES_URL_NON_POOLING: Direct Connection (port 5432) - For migrations only
#   - Set automatically by: Vercel Supabase Integration
#   - Used by: Database migrations (yarn migrate)
#   - Why: Migrations need direct connection features not available in transaction mode
#   - Format: postgresql://postgres:[PASSWORD]@db.xxx.supabase.co:5432/postgres
#   - To get: Supabase Dashboard → Settings → Database → Connect → Direct connection
#   - Note: If using Vercel integration, this is set automatically. Only set manually if not using integration.
#
# POSTGRES_DIRECT_URL: Direct Connection (port 5432) - For migrations (manual setup only)
#   - Used by: Database migrations when POSTGRES_URL_NON_POOLING is not available
#   - Only needed if: Not using Vercel Supabase Integration
#   - Format: postgresql://postgres:[PASSWORD]@db.xxx.supabase.co:5432/postgres
#   - To get: Supabase Dashboard → Settings → Database → Connect → Direct connection
#
# Connection Pooler Configuration:
#   - The application uses a connection pooler with max 15 connections
#   - Optimized for serverless: min 0, idle timeout 30s, allowExitOnIdle enabled
#   - This prevents connection exhaustion in Vercel's serverless environment
#
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_DIRECT_URL=

# =============================================================================
# API SECURITY
# =============================================================================
# API key required for the /api/subscribe endpoint
# Set to a random secure string, then use it in fractal.boston's subscribe form
SUBSCRIBE_API_KEY=

# =============================================================================
# SUBSTACK - Subscriber import (optional)
# =============================================================================
# API key for Substack API (if available)
# Note: Substack may not have a public API for subscriber lists
# Alternative: Export CSV from Substack dashboard and parse it
# Get from: Substack Dashboard → Settings → API (if available)
SUBSTACK_API_KEY=

# =============================================================================
# APPLICATION
# =============================================================================
# Base URL for the application, used in email links
# Development: http://localhost:3000
# Production: https://fractal.boston
APP_URL=http://localhost:3000

# Email sending control
# Set to "true" to enable email sending, "false" to disable (defaults to false)
# When disabled, emails will be logged to Discord but not actually sent
EMAIL_ENABLED=false

# =============================================================================
# VERCEL (Auto-configured)
# =============================================================================
# Automatically set by Vercel for cron job authentication
# Do not set manually - Vercel manages this
CRON_SECRET=

# Optional. If set, requests with header x-admin-api-key matching this value are allowed for cron-protected routes.
ADMIN_API_KEY=

# VERCEL is set by Vercel at runtime when deployed. If present (any value), test email page/API are hidden.
