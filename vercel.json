{
  "crons": [
    {
      "path": "/api/cron/email-weekly",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron/discord-weekly",
      "schedule": "0 13 * * 1"
    }
  ],
  "functions": {
    "src/app/api/cron/email-weekly/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/cron/discord-weekly/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/webhooks/luma/event/route.ts": {
      "maxDuration": 300
    }
  }
}
